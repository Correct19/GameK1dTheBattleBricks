        TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
        
        callback(state)
    end)
end

_G.GameK1dEnabled = false
local descendantConnection = nil
local quizScanSpawned = false

createToggleRow(Content, "GameK1d", "133516881835614", function(enabled)
    _G.GameK1dEnabled = enabled
    if _G.GameK1dEnabled then
        task.spawn(executeFullCleanup)
        
        if not descendantConnection then
            descendantConnection = playerGui.DescendantAdded:Connect(function(child)
                if _G.GameK1dEnabled then
                    local insideAssets = false
                    local insideGame = false
                    local gameName = ""
                    
                    local parentObj = child.Parent
                    while parentObj do
                        if parentObj.Name == "Assets" and parentObj.Parent and parentObj.Parent.Name == "FunGui" then
                            insideAssets = true
                            break
                        end
                        if gamesToDelete[parentObj.Name] then
                            insideGame = true
                            gameName = parentObj.Name
                        end
                        parentObj = parentObj.Parent
                    end
                    
                    if insideAssets and namesToDestroy[child.Name] then
                        destroyObject(child)
                    end
                    
                    if insideGame then
                        for _, itemName in pairs(gamesToDelete[gameName]) do
                            if child.Name == itemName then
                                destroyObject(child)
                            end
                        end
                    end
                end
            end)
        end
        
        if not quizScanSpawned then
            quizScanSpawned = true
            task.spawn(function()
                while _G.GameK1dEnabled do
                    pcall(scanAndCheckScreen)
                    task.wait(0.1)
                end
            end)
        end
    else
        if descendantConnection then
            descendantConnection:Disconnect()
            descendantConnection = nil
        end
        quizScanSpawned = false
    end
end)

