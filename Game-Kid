local function clickTargetButtonDirect(target, isFast)
    if not target then return end
    
    if target:IsA("TextLabel") and target.Parent then
        target = target.Parent
    end

    local absolutePosition = target.AbsolutePosition
    local absoluteSize = target.AbsoluteSize
    
    local centerX = absolutePosition.X + (absoluteSize.X / 2)
    local centerY = absolutePosition.Y + (absoluteSize.Y / 2)
    
    local guiInset, _ = GuiService:GetGuiInset()
    local clickX = centerX + guiInset.X
    local clickY = centerY + guiInset.Y
    
    if UserInputService.TouchEnabled then
        local touchId = 1
        VirtualInputManager:SendTouchEvent(touchId, 0, clickX, clickY)
        task.wait(isFast and 0.01 or 0.02)
        VirtualInputManager:SendTouchEvent(touchId, 2, clickX, clickY)
        VirtualInputManager:SendTouchEvent(touchId, 2, -100, -100)
    else
        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 0)
        task.wait(isFast and 0.01 or 0.02)
        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 0)
        VirtualInputManager:SendMouseMoveEvent(-100, -100, game)
    end
end

local function scanAndCheckScreen()
    if cooldown then return end

    for _, descendant in pairs(playerGui:GetDescendants()) do
        if descendant.Name == "Answers" then
            for _, answerBtn in pairs(descendant:GetChildren()) do
                local textLabel = answerBtn:FindFirstChildOfClass("TextLabel") or answerBtn:FindFirstChild("TextLabel")
                if textLabel and textLabel.Visible then
                    local cleanText = normalizeText(textLabel.Text)
                    if answerList[cleanText] then
                        cooldown = true
                        clickTargetButtonDirect(answerBtn, false)
                        task.wait(0.5)
                        cooldown = false
                        return
                    end
                end
            end
        end
    end

    local descendants = playerGui:GetDescendants()
    for i = 1, #descendants do
        local obj = descendants[i]
        if obj.Visible and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
            local cleanText = normalizeText(obj.Text)
            if cleanText ~= "" and gamesFastClick[cleanText] then
                cooldown = true
                clickTargetButtonDirect(obj, true)
                task.wait(0.12)
                cooldown = false
                return
            end
        end
    end
end

local function cleanAssetsAndFrames(funGuiInstance)
    if not funGuiInstance then return end
    
    local assetsFolder = funGuiInstance:FindFirstChild("Assets")
    if assetsFolder then
        for name, _ in pairs(namesToDestroy) do
            local obj = assetsFolder:FindFirstChild(name)
            if obj then destroyObject(obj) end
        end
    end
    
    local gamesFolder = funGuiInstance:FindFirstChild("Games")
    if gamesFolder then
        for gameName, itemsToDelete in pairs(gamesToDelete) do
            local gameFolder = gamesFolder:FindFirstChild(gameName)
            if gameFolder then
                for _, itemName in pairs(itemsToDelete) do
                    local obj = gameFolder:FindFirstChild(itemName)
                    if obj then destroyObject(obj) end
                end
            end
        end
        
        local BossFight = gamesFolder:FindFirstChild("BossFight")
        if BossFight then
            local characterFrame = BossFight:FindFirstChild("CharacterFrame")
            if characterFrame then
                pcall(function()
                    characterFrame:SetAttribute("Hitbox", Vector2.new(0, 0))
                end)
            end
        end
    end
end

local function executeFullCleanup()
    local funGuiRep = ReplicatedStorage:FindFirstChild("Cutscenes") and ReplicatedStorage.Cutscenes:FindFirstChild("FunGui")
    if funGuiRep then
        cleanAssetsAndFrames(funGuiRep)
    end

    for _, p in pairs(Players:GetPlayers()) do
        local pGui = p:FindFirstChild("PlayerGui")
        if pGui then
            local clonedFunGui = pGui:FindFirstChild("FunGui")
            if clonedFunGui then
                cleanAssetsAndFrames(clonedFunGui)
            end
        end
    end
end

